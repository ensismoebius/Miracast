# SPDX-License-Identifier: GPL-2.0-or-later
# Maintainer: André Furlan <ensismoebius@gmail.com>
pkgname=miracast
pkgver=1.0.0
pkgrel=1
pkgdesc='Miracast (Wi-Fi Display) source and sink for Linux, over the network (MS-MICE) or Wi-Fi Direct'
arch=('x86_64' 'aarch64')
url='https://github.com/ensismoebius/Miracast'
license=('GPL-2.0-or-later')
depends=('gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad'
         'gst-plugins-ugly' 'gst-libav' 'gst-plugin-va' 'gst-plugin-pipewire'
         'pipewire' 'glib2')
makedepends=('cmake')
optdepends=('dnsmasq: DHCP server when acting as a Wi-Fi Direct sink'
            'wpa_supplicant: Wi-Fi Direct (needs a P2P-capable adapter)'
            'iproute2: group addressing for Wi-Fi Direct')
conflicts=('miracast-git')
# packaging/build.sh builds from a local tarball: MIRACAST_SOURCE=<file> MIRACAST_SHA256=SKIP
source=("${MIRACAST_SOURCE:-${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz}")
sha256sums=("${MIRACAST_SHA256:-5269f88e898c6d90dcfffafc51b2d49b9394b260b0f4bc5c6ae595e99c4e3dd9}")

build() {
	cmake -S "${srcdir}/Miracast-${pkgver}" -B build -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm644 "${srcdir}/Miracast-${pkgver}/LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
